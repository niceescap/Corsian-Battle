<?xml version="1.0" encoding="utf-8"?>
<!--
  Sécurité réseau Android.

  En production, HTTPS et WSS uniquement : le trafic en clair est INTERDIT
  (`android:usesCleartextTraffic="false"`). Le serveur est toujours en
  127.0.0.1 derrière nginx, et nginx termine le TLS.

  Exception de développement : le backend local parle en HTTP sur
  127.0.0.1 / 10.0.2.2 (émulateur) / le LAN. Ces adresses sont autorisées
  en clair UNIQUEMENT pour le développement — le trafic public reste en
  HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Backend local, loopback. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Backend local vu depuis l'émulateur Android. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Plage privée, pour un téléphone physique en développement. -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
    </domain-config>
</network-security-config>
