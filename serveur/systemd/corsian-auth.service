# Corsian-Battle — service d'authentification (8111).
#
# Installé sur la machine de production (`noe`), dans
# `/etc/systemd/system/corsian-auth.service`.
#
# Le dépôt ne contient QUE le modèle : l'unité réelle est copiée par
# `serveur/deployer.sh`, qui y remplace le chemin de déploiement. Le chemin
# ci-dessous est donc une valeur par défaut à ajuster.

[Unit]
Description=Corsian-Battle — authentification (8111)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nicee
Group=nicee
WorkingDirectory=/home/nicee/corsian-battle
EnvironmentFile=/etc/corsian/auth.env
ExecStart=/home/nicee/corsian-battle/.venv/bin/uvicorn serveur.auth.main:app \
          --host 127.0.0.1 --port 8111 --workers 1 \
          --proxy-headers --forwarded-allow-ips 127.0.0.1 \
          --no-access-log
Restart=always
RestartSec=3

# Durcissement — ce service n'a besoin d'écrire que dans var/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nicee/corsian-battle/var /home/nicee/corsian-battle/sauvegardes
MemoryMax=350M
CPUQuota=60%

[Install]
WantedBy=multi-user.target
